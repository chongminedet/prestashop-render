FROM prestashop/prestashop:8-apache

# Back Office is served from /admin-panel
ENV PS_FOLDER_ADMIN=admin-panel

# Apache: listen on all interfaces, silence default-vhost warnings,
# enable the headers module (used for security headers).
#
# NOTE: /var/www/html/install is intentionally KEPT in the image.
# The database was lost when the Railway free tier was cancelled, so the
# PrestaShop web installer must be runnable once against the new database.
# After installation the runtime script locks it again (see run-app.sh).
RUN echo 'Listen 0.0.0.0:80' > /etc/apache2/ports.conf \
    && echo 'ServerName 127.0.0.1' >> /etc/apache2/apache2.conf \
    && a2enmod headers \
    && (cp -a /var/www/html/admin-dev /var/www/html/admin-panel 2>/dev/null \
        || cp -a /var/www/html/admin /var/www/html/admin-panel 2>/dev/null \
        || true)

# Runtime scripts. Render Free instances have an ephemeral filesystem:
# parameters.php is therefore regenerated from environment variables on
# EVERY boot (see docker/run-app.sh) instead of being baked into the image.
COPY run-app.sh /run-app.sh
COPY gen-parameters.php /usr/local/bin/gen-parameters.php
RUN chmod +x /run-app.sh

CMD ["/run-app.sh"]
